{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "welcome",
  "description": "gfx studio welcome window (docs/HOME-SETTINGS.md \u00a71): recent list, folders, new / open project, setup status",
  "windows": [
    "welcome"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-get-settings",
    "allow-settings-meta",
    "allow-patch-settings",
    "allow-refresh-project-metadata",
    "allow-pick-folder",
    "allow-project-info",
    "allow-engine-run",
    "allow-engine-cancel",
    "allow-engine-info",
    "allow-engines-info",
    "allow-t3-status",
    "allow-recent-list",
    "allow-classify-folder",
    "allow-recent-remove",
    "allow-recent-pin",
    "allow-recent-relocate",
    "allow-folder-add",
    "allow-folder-remove",
    "allow-recent-import",
    "allow-list-templates",
    "allow-project-thumb",
    "allow-reveal-project",
    "allow-main-open",
    "allow-welcome-open",
    "allow-welcome-settings",
    "allow-wsl-distros",
    "allow-wsl-bundle-info",
    "allow-wsl-engine-setup",
    "allow-wsl-engine-checks",
    "allow-wsl-engine-remove",
    "allow-windows-path-state",
    "allow-set-windows-path",
    "allow-open-link"
  ]
}
